{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": { "type": "integer" },
    "firstName": { "type": "string" },
    "secondName": { "type": "string" },
    "age": { "type": "integer" },
    "sex": { "type": "string", "enum": ["MALE", "FEMALE"] },
    "money": { "type": "number" },
    "house": { "type": ["integer", "null"] },
    "cars": {
      "type": "array",
      "items": { "$ref": "car-schema.json" }
    }
  },
  "required": [
    "id",
    "firstName",
    "secondName",
    "age",
    "sex",
    "money",
    "house",
    "cars"
  ],
  "additionalProperties": false
}